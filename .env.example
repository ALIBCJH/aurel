# Enquiry delivery — used by src/app/api/contact/route.ts
#
# Set ONE of the two channels below. With neither set the contact form still
# accepts briefs and the site works, but nothing is delivered: the route logs
# the brief with a warning instead. That is fine locally, not in production.
#
# Copy this file to `.env.local` (git-ignored) and fill in what you use.

# --- Option A: email via Resend (https://resend.com) -------------------------
# The route calls Resend's REST API directly, so there is no package to install.
RESEND_API_KEY=

# Must be an address on a domain you have verified with Resend. The default
# sandbox sender (onboarding@resend.dev) only delivers to your own account
# address, so replace it before launch.
CONTACT_FROM_EMAIL="Mojah Investments <enquiries@example.co.ke>"

# --- Option B: post the enquiry somewhere (Slack, Zapier, a CRM) -------------
# Ignored when RESEND_API_KEY is set.
CONTACT_WEBHOOK_URL=

# --- REQUIRED for email delivery ---------------------------------------------
# Where enquiries are sent. This normally falls back to siteConfig.email in
# src/config/site.ts — but that is deliberately BLANK until a real Mojah
# address exists, so with Resend configured this variable is currently the only
# thing that makes email delivery work. Without it (and without a webhook) the
# form accepts enquiries and logs a warning, and nobody reads them.
CONTACT_TO_EMAIL=

# --- Search / hosting ---------------------------------------------------------
# The canonical origin, no trailing slash. Every canonical link, sitemap URL and
# schema.org @id is built from this, so it MUST match the domain the site is
# actually served from — a mismatch tells Google the real pages are canonical
# somewhere else, which is how a site deindexes itself.
#
# Unset, it falls back to https://mojahinvestments.co.ke (see
# src/config/site.ts) — which is a GUESS, not a confirmed domain. Set this to
# whatever Mojah actually owns before launch.
# A .co.ke domain is worth keeping: Google reads a country-code domain as an
# explicit Kenya target, which a generic .com cannot express.
NEXT_PUBLIC_SITE_URL=

# Google Search Console ownership token — the value from the "HTML tag"
# verification method, i.e. the content attribute only, not the whole tag.
# Until the property is verified you cannot submit the sitemap or see which
# queries the site surfaces for. Do this first after pointing the domain.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
